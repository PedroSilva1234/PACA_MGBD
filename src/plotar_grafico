import matplotlib.pyplot as plt
import numpy as np
import re
import os

from dataclasses import dataclass

@dataclass
class ParametrosReta:
    m: float
    b: float
    identificador: str = ""  # Adicionado para identificar a reta, se necessário


def extrair_parametros(filepath):
    """Extrai os parâmetros m e b do ficheiro .data usando regex."""
    try:
        with open(filepath, 'r') as f:
            conteudo = f.read()
        
        # Regex atualizado para aceitar nan e inf (ignorando maiúsculas/minúsculas)
        match = re.search(r"Reta com (?:FLOAT|DOUBLE)\s*:\s*y\s*=\s*([-+]?(?:\d*\.\d+|\d+|nan|inf))\s*x\s*\+\s*([-+]?(?:\d*\.\d+|\d+|nan|inf))", conteudo, re.IGNORECASE)
        if match:
            return float(match.group(1)), float(match.group(2))
        return None, None
    except Exception:
        return None, None

